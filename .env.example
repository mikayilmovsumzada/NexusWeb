# Copy to .env.local and fill in. All values are optional except NEXT_PUBLIC_SITE_URL in production.
# Anything left empty is simply not shown on the site (no placeholder links).
# NEXT_PUBLIC_* values are embedded in the client bundle at build time — never put secrets here.

# Canonical public URL, used for SEO metadata, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address shown on the Contact page (default in src/config/site.ts).
NEXT_PUBLIC_CONTACT_EMAIL=
# Public phone number in international format, e.g. +994551234567 (default in src/config/site.ts).
NEXT_PUBLIC_CONTACT_PHONE=

# Social profiles — only configured ones are rendered.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# External URLs must be https:// (plain http:// is accepted only for localhost testing).
# Invalid values are ignored with a "[config] Ignoring ..." warning in the build log.

# ContextPulse AI
NEXT_PUBLIC_CONTEXTPULSE_REPO_URL=https://github.com/mikayilmovsumzada/ContextPulse-AI
# "Try Live Demo" target: the separately deployed ContextPulse application.
# Leave EMPTY until the deployment is live and reachable — the product page then shows
# "Live demo not available yet" instead of a broken link.
#   Production (intended):  https://contextpulse.nexusweb.az
#   Local testing:          http://localhost:8001   (ContextPulse running via uvicorn)
NEXT_PUBLIC_CONTEXTPULSE_DEMO_URL=
# Optional early-access form URL. When empty, the page says registration isn't open yet.
NEXT_PUBLIC_CONTEXTPULSE_BETA_URL=

# ---------------------------------------------------------------------------
# Server-only (NOT NEXT_PUBLIC_): contact inbox and admin area at /admin.
# Create the first two with:  npm run admin:setup
# Without them, /admin does not exist (404). See README → "Contact form and admin inbox".
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Optional: only these IPs may reach /admin at all (others get 403). Needs TRUST_PROXY=1.
ADMIN_ALLOWED_IPS=
# Production behind nginx/Caddy: read the visitor IP from X-Real-IP. Leave empty locally.
TRUST_PROXY=
# Optional database folder (default ./data, git-ignored).
NEXUSWEB_DATA_DIR=
